# Safe template only. The application does NOT automatically load .env.
# Export variables in your shell, or explicitly use uvicorn --env-file .env.
# Both credential fields are optional; leave blank for deterministic offline mode.
GEMINI_API_KEY=
# Optional existing alias; do not set two different keys.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
LOG_LEVEL=INFO

# Bounded process-local limits: limit <=10000, window <=86400, clients <=100000.
# RATE_LIMIT * RATE_MAX_CLIENTS <=1000000. Capacity exhaustion rejects NEW clients.
RATE_LIMIT=30
RATE_WINDOW=60
RATE_MAX_CLIENTS=10000

# Empty trusts only the socket peer. Explicit IPs/canonical CIDRs only.
# Launch with --no-proxy-headers; never set legacy TRUST_PROXY=1.
TRUSTED_PROXY_CIDRS=

# Local/single-instance default. Use an absolute durable path in deployment.
EVENTRA_DB_PATH=data/eventra.sqlite3
# K_SERVICE is platform-controlled: when present, SQLite workspace APIs fail closed.
# PORT is consumed only by the existing Docker startup command (default 8080).
